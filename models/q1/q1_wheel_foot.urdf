<?xml version="1.0"?>
<robot name="q1_wheel_foot">
  <!-- Quanta Computer Q1 Edu — transformable wheel-foot humanoid (URDF) -->
  <link name="base_link">
    <visual>
      <geometry><cylinder length="0.18" radius="0.10"/></geometry>
      <material name="suit"><color rgba="0.78 0.80 0.83 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder length="0.18" radius="0.10"/></geometry>
    </collision>
    <inertial>
      <mass value="8"/>
      <inertia ixx="0.12" ixy="0" ixz="0" iyy="0.10" iyz="0" izz="0.08"/>
    </inertial>
  </link>

  <link name="torso">
    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry><cylinder length="0.30" radius="0.10"/></geometry>
      <material name="suit"/>
    </visual>
    <inertial>
      <mass value="6"/>
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.07" iyz="0" izz="0.05"/>
    </inertial>
  </link>
  <joint name="waist_yaw" type="revolute">
    <parent link="base_link"/><child link="torso"/>
    <origin xyz="0 0 0.10"/><axis xyz="0 0 1"/>
    <limit lower="-0.5" upper="0.5" effort="40" velocity="3"/>
  </joint>

  <link name="head">
    <visual>
      <geometry><sphere radius="0.09"/></geometry>
      <material name="head"><color rgba="0.07 0.08 0.09 1"/></material>
    </visual>
    <inertial><mass value="1.2"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="neck" type="revolute">
    <parent link="torso"/><child link="head"/>
    <origin xyz="0 0 0.40"/><axis xyz="0 1 0"/>
    <limit lower="-0.35" upper="0.35" effort="10" velocity="3"/>
  </joint>

  <!-- Left leg -->
  <link name="l_thigh">
    <visual><origin xyz="0 0 -0.15"/><geometry><cylinder length="0.30" radius="0.048"/></geometry><material name="suit"/></visual>
    <inertial><mass value="3.5"/><inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="l_hip" type="revolute">
    <parent link="base_link"/><child link="l_thigh"/>
    <origin xyz="0 0.095 -0.02"/><axis xyz="0 1 0"/>
    <limit lower="-1.3" upper="1.3" effort="80" velocity="8"/>
  </joint>

  <link name="l_shank">
    <visual><origin xyz="0 0 -0.15"/><geometry><cylinder length="0.30" radius="0.038"/></geometry><material name="suit"/></visual>
    <inertial><mass value="2.5"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.008"/></inertial>
  </link>
  <joint name="l_knee" type="revolute">
    <parent link="l_thigh"/><child link="l_shank"/>
    <origin xyz="0 0 -0.30"/><axis xyz="0 1 0"/>
    <limit lower="0" upper="2.2" effort="100" velocity="8"/>
  </joint>

  <link name="l_ankle_mount">
    <inertial><mass value="0.4"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/></inertial>
  </link>
  <joint name="l_ankle" type="revolute">
    <parent link="l_shank"/><child link="l_ankle_mount"/>
    <origin xyz="0 0 -0.30"/><axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="0.8" effort="40" velocity="8"/>
  </joint>

  <!-- transform: 0=wheel, pi/2=biped -->
  <link name="l_wheel">
    <visual><geometry><cylinder length="0.064" radius="0.095"/></geometry><material name="wheel"><color rgba="0.1 0.1 0.12 1"/></material></visual>
    <collision><geometry><cylinder length="0.064" radius="0.095"/></geometry></collision>
    <inertial><mass value="1.0"/><inertia ixx="0.004" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.004"/></inertial>
  </link>
  <joint name="l_transform" type="revolute">
    <parent link="l_ankle_mount"/><child link="l_wheel"/>
    <origin xyz="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="0" upper="1.5708" effort="50" velocity="4"/>
  </joint>
  <joint name="l_wheel_spin" type="continuous">
    <parent link="l_wheel"/><child link="l_wheel_spin_link"/>
    <origin xyz="0 0 0"/><axis xyz="0 1 0"/>
  </joint>
  <link name="l_wheel_spin_link"><inertial><mass value="0.01"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial></link>

  <!-- Right leg (mirrored) -->
  <link name="r_thigh">
    <visual><origin xyz="0 0 -0.15"/><geometry><cylinder length="0.30" radius="0.048"/></geometry><material name="suit"/></visual>
    <inertial><mass value="3.5"/><inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="r_hip" type="revolute">
    <parent link="base_link"/><child link="r_thigh"/>
    <origin xyz="0 -0.095 -0.02"/><axis xyz="0 1 0"/>
    <limit lower="-1.3" upper="1.3" effort="80" velocity="8"/>
  </joint>
  <link name="r_shank">
    <visual><origin xyz="0 0 -0.15"/><geometry><cylinder length="0.30" radius="0.038"/></geometry><material name="suit"/></visual>
    <inertial><mass value="2.5"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.008"/></inertial>
  </link>
  <joint name="r_knee" type="revolute">
    <parent link="r_thigh"/><child link="r_shank"/>
    <origin xyz="0 0 -0.30"/><axis xyz="0 1 0"/>
    <limit lower="0" upper="2.2" effort="100" velocity="8"/>
  </joint>
  <link name="r_ankle_mount">
    <inertial><mass value="0.4"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/></inertial>
  </link>
  <joint name="r_ankle" type="revolute">
    <parent link="r_shank"/><child link="r_ankle_mount"/>
    <origin xyz="0 0 -0.30"/><axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="0.8" effort="40" velocity="8"/>
  </joint>
  <link name="r_wheel">
    <visual><geometry><cylinder length="0.064" radius="0.095"/></geometry><material name="wheel"/></visual>
    <collision><geometry><cylinder length="0.064" radius="0.095"/></geometry></collision>
    <inertial><mass value="1.0"/><inertia ixx="0.004" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.004"/></inertial>
  </link>
  <joint name="r_transform" type="revolute">
    <parent link="r_ankle_mount"/><child link="r_wheel"/>
    <origin xyz="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="0" upper="1.5708" effort="50" velocity="4"/>
  </joint>
  <joint name="r_wheel_spin" type="continuous">
    <parent link="r_wheel"/><child link="r_wheel_spin_link"/>
    <origin xyz="0 0 0"/><axis xyz="0 1 0"/>
  </joint>
  <link name="r_wheel_spin_link"><inertial><mass value="0.01"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial></link>
</robot>
